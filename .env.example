# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Nunca versione o .env.local.

# Frontend (públicas por design; o acesso é protegido pelas políticas de RLS)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Backend (funções em /api na Vercel). NUNCA use prefixo VITE_ aqui.
OPENAI_API_KEY=
