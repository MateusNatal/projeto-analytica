# Copie para .env.local e preencha com os dados do seu projeto.
# Nunca versione o .env.local.

# --- Frontend -----------------------------------------------------------------
# Públicas por design: o acesso aos dados é protegido pelas políticas de RLS.
# Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# --- Backend (funções em /api na Vercel) ----------------------------------------
# NUNCA use o prefixo VITE_ nestas variáveis: tudo que começa com VITE_ vai
# para o JavaScript enviado ao navegador.
# Gemini API (Google AI Studio > Get API key).
GEMINI_API_KEY=
# Opcionais
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
AI_DAILY_LIMIT=20
